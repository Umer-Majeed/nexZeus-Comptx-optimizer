<Window x:Class="NexZeus.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NexZeus" Height="380" Width="440"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Topmost="True"
        Opacity="0">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- Window Fade In Animation -->
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.6"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border Background="#0B0C0E" CornerRadius="18" BorderBrush="#232A1F" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#000000" Opacity="0.9"/>
        </Border.Effect>

        <!-- Main Layout Grid: Top (Logo) aur Bottom (UI) -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <!-- 1. Top Area: Logo (Expands to fill space) -->
                <RowDefinition Height="Auto"/>
                <!-- 2. Bottom Area: All UI Elements (Fixed size) -->
            </Grid.RowDefinitions>

            <!-- 1. BARA LOGO (Top Area mein center) -->
            <Image Grid.Row="0" Source="Assets/nexlogo.png" Stretch="Uniform" 
                   Width="328" Height="328" 
                   HorizontalAlignment="Left" VerticalAlignment="Top" Grid.RowSpan="2" Margin="44,4,0,0"/>

            <!-- 2. BAQI SARA UI (Bottom Area mein stacked) -->
            <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,0,0,30">
                <!-- App Title -->
                <TextBlock Text="NEX ZEUS" FontSize="26" FontWeight="Bold" Foreground="#F9FAFB" HorizontalAlignment="Center"/>
                <!-- Subtitle -->
                <TextBlock Text="GAMING INTELLIGENCE PLATFORM" FontSize="9.5" Foreground="#A7D129" FontWeight="SemiBold" Margin="0,4,0,25" HorizontalAlignment="Center"/>

                <!-- Custom Styled Progress Bar -->
                <ProgressBar x:Name="LoadProgress" Width="300" Height="4" Minimum="0" Maximum="100"
                             Background="#16181C" Foreground="#A7D129" BorderThickness="0"/>

                <!-- Status Text -->
                <TextBlock x:Name="LoadingStatusText" Text="Verifying hardware monitors..." FontSize="10" Foreground="#6B7280"
                           Margin="0,8,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
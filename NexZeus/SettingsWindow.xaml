<Window x:Class="NexZeus.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NexZeus Settings" Height="300" Width="350" Background="#1e1e1e"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock Text="High Ping Threshold (ms)" Foreground="White" Margin="0,0,0,5"/>
        <TextBox x:Name="PingThresholdBox" Width="200" HorizontalAlignment="Left" Margin="0,0,0,15"/>

        <TextBlock Text="High CPU Threshold (%)" Foreground="White" Margin="0,0,0,5"/>
        <TextBox x:Name="CpuThresholdBox" Width="200" HorizontalAlignment="Left" Margin="0,0,0,15"/>

        <Button Content="Save" Width="100" Height="30" Click="Save_Click" HorizontalAlignment="Left"/>
    </StackPanel>
</Window>
<Window x:Class="NexZeus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NexZeus"
        mc:Ignorable="d"
        Title="NEXZEUS // GAMING INTELLIGENCE PLATFORM" Height="850" Width="470"
        Background="#0B0C0E" WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="BrandLime" Color="#A7D129"/>
        <SolidColorBrush x:Key="BrightRed" Color="#FF3333"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="TextWhite" Color="#F9FAFB"/>

        <!-- Dark Grainy Grunge Texture Gradient -->
        <LinearGradientBrush x:Key="GrungeCardTexture" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1A1B1E" Offset="0.0"/>
            <GradientStop Color="#121316" Offset="0.3"/>
            <GradientStop Color="#0D0E10" Offset="0.7"/>
            <GradientStop Color="#151619" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SubPanelGrunge" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#16181C" Offset="0.0"/>
            <GradientStop Color="#0F1012" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Cards Style with Subtle Depth & Grunge Texture -->
        <Style TargetType="Border" x:Key="GamingCard">
            <Setter Property="Background" Value="{StaticResource GrungeCardTexture}"/>
            <Setter Property="BorderBrush" Value="#25282F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="16,8,16,8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="6" BlurRadius="14" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Inner Sub-Card Style -->
        <Style TargetType="Border" x:Key="GlassSubCard">
            <Setter Property="Background" Value="{StaticResource SubPanelGrunge}"/>
            <Setter Property="BorderBrush" Value="#20232B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <!-- Interactive Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1B1D23"/>
            <Setter Property="Foreground" Value="{StaticResource TextWhite}"/>
            <Setter Property="BorderBrush" Value="#2C303B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#23262D"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrandLime}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrandLime}"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Accent Button -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#A7D129"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#B8E638"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Typography -->
        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="Foreground" Value="{StaticResource BrandLime}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="MetricLabel">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="MetricValue">
            <Setter Property="Foreground" Value="{StaticResource TextWhite}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <StackPanel Margin="0,0,0,20">

            <!-- Top Header Bar -->
            <Border Background="#121316" Padding="16,12,16,12" Margin="0,0,0,8" BorderBrush="#202227" BorderThickness="0,0,0,1">
                <Grid>
                    <Image Source="pack://application:,,,/NexZeus;component/Assets/logo.png" 
                           Height="34" 
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Center" 
                           Stretch="Uniform"/>
                    <Button Content="⚙ SETTINGS" Width="85" Height="30" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OpenSettings_Click"/>
                </Grid>
            </Border>

            <!-- Roblox Status Banner -->
            <Border Style="{StaticResource GamingCard}">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#6B7280" Margin="0,0,8,0"/>
                        <TextBlock x:Name="RobloxStatusText" Text="ROBLOX: NOT RUNNING" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Hardware Telemetry Section -->
            <Border Style="{StaticResource GamingCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="⚡ HARDWARE TELEMETRY" Style="{StaticResource SectionHeader}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="GpuText" Text="GPU: --" Style="{StaticResource MetricLabel}" HorizontalAlignment="Right" MaxWidth="220" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- CPU Stat Box -->
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource GlassSubCard}" Padding="12,10" Margin="0,0,5,6">
                            <StackPanel>
                                <TextBlock Text="CPU LOAD" Style="{StaticResource MetricLabel}"/>
                                <TextBlock x:Name="CpuText" Text="--%" Style="{StaticResource MetricValue}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- App RAM Stat Box -->
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource GlassSubCard}" Padding="12,10" Margin="5,0,0,6">
                            <StackPanel>
                                <TextBlock Text="APP RAM" Style="{StaticResource MetricLabel}"/>
                                <TextBlock x:Name="RamText" Text="-- GB" Style="{StaticResource MetricValue}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- System RAM Stat Box -->
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource GlassSubCard}" Padding="12,10" Margin="0,6,5,0">
                            <StackPanel>
                                <TextBlock Text="SYS RAM USAGE" Style="{StaticResource MetricLabel}"/>
                                <TextBlock x:Name="SysRamText" Text="-- / -- GB" Style="{StaticResource MetricValue}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Stutter Detector Stat Box -->
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource GlassSubCard}" Padding="12,10" Margin="5,6,0,0">
                            <StackPanel>
                                <TextBlock Text="STUTTER COUNTER" Style="{StaticResource MetricLabel}"/>
                                <TextBlock x:Name="StutterText" Text="0" Style="{StaticResource MetricValue}" Foreground="{StaticResource BrightRed}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Network Diagnostics Section -->
            <Border Style="{StaticResource GamingCard}">
                <StackPanel>
                    <TextBlock Text="🌐 NETWORK DIAGNOSTICS" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource GlassSubCard}" Padding="10,8" Margin="0,0,4,0">
                            <StackPanel>
                                <TextBlock Text="PING" Style="{StaticResource MetricLabel}"/>
                                <TextBlock x:Name="PingText" Text="-- ms" Style="{StaticResource MetricValue}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource GlassSubCard}" Padding="10,8" Margin="2,0,2,0">
                            <StackPanel>
                                <TextBlock Text="JITTER" Style="{StaticResource MetricLabel}"/>
                                <TextBlock x:Name="JitterText" Text="-- ms" Style="{StaticResource MetricValue}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource GlassSubCard}" Padding="10,8" Margin="4,0,0,0">
                            <StackPanel>
                                <TextBlock Text="PACKET LOSS" Style="{StaticResource MetricLabel}"/>
                                <TextBlock x:Name="PacketLossText" Text="0.0%" Style="{StaticResource MetricValue}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Real-time Threshold Warning Banner -->
            <Border Style="{StaticResource GamingCard}" Padding="12,8">
                <TextBlock x:Name="WarningText" Text="System Status: Normal" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            </Border>

            <!-- Interactive Tweaks Engine Section -->
            <Border Style="{StaticResource GamingCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="🛠 ACTIVE GAME TWEAKS" Style="{StaticResource SectionHeader}" VerticalAlignment="Center"/>
                        <CheckBox x:Name="AutoOptimizeCheckBox" Content="Auto-Apply on BloxStrike" Foreground="{StaticResource TextMuted}" FontSize="10" HorizontalAlignment="Right" Click="AutoOptimize_Changed"/>
                    </Grid>

                    <ItemsControl x:Name="TweaksList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GlassSubCard}" Padding="10,8" Margin="0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextWhite}" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Tag="{Binding Id}" VerticalAlignment="Center" Margin="10,0,0,0" Click="TweakToggled"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Windows System Optimization Section -->
            <Border Style="{StaticResource GamingCard}">
                <StackPanel>
                    <TextBlock Text="⚙ WINDOWS OPTIMIZATION" Style="{StaticResource SectionHeader}" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Content="Check Settings" Grid.Column="0" Margin="0,0,5,0" Click="CheckOptimization_Click"/>
                        <Button Content="Apply Fixes" Grid.Column="1" Style="{StaticResource AccentButton}" Margin="5,0,0,0" Click="ApplyFixes_Click"/>
                    </Grid>

                    <Border Style="{StaticResource GlassSubCard}" Padding="10">
                        <TextBlock x:Name="OptimizationText" Text="Click 'Check Settings' to view system optimization status." Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Background Process Manager Card -->
            <Border Style="{StaticResource GamingCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="🛑 BACKGROUND PROCESSES" Style="{StaticResource SectionHeader}" VerticalAlignment="Center"/>
                        <Button Content="Refresh" Width="70" Height="26" FontSize="10" HorizontalAlignment="Right" Click="RefreshProcesses_Click"/>
                    </Grid>

                    <ItemsControl x:Name="ProcessList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GlassSubCard}" Padding="8,6" Margin="0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextWhite}" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding RamMB, StringFormat='{}{0} MB'}" Foreground="{StaticResource TextMuted}" FontSize="10"/>
                                        </StackPanel>

                                        <Button Grid.Column="1" Content="Suspend" Width="65" Height="26" FontSize="10" Margin="5,0"
                                                Click="SuspendProcess_Click" Tag="{Binding Pid}"/>
                                        <Button Grid.Column="2" Content="Resume" Width="65" Height="26" FontSize="10"
                                                Click="ResumeProcess_Click" Tag="{Binding Pid}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <CheckBox x:Name="AutoSuspendCheckBox" Content="Auto-suspend these on BloxStrike start"
                             Foreground="White" FontSize="11" Margin="0,10,0,0" Checked="AutoSuspend_Changed" Unchecked="AutoSuspend_Changed"/>
                </StackPanel>
            </Border>

            <!-- Control Actions Bar -->
            <Border Style="{StaticResource GamingCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Content="START DIAGNOSTICS" Grid.Column="0" Style="{StaticResource AccentButton}" Margin="0,0,5,0" Click="StartButton_Click"/>
                        <Button Content="STOP SESSION" Grid.Column="1" Margin="5,0,0,0" Click="StopSession_Click"/>
                    </Grid>

                    <Button Content="VIEW HISTORICAL SESSIONS" Click="ViewHistory_Click"/>

                    <Border Style="{StaticResource GlassSubCard}" Padding="10" Margin="0,10,0,0">
                        <TextBlock x:Name="ReportText" Text="Session report status will display here..." Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>
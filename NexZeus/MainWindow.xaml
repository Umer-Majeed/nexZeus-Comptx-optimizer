<Window x:Class="NexZeus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NexZeus"
        mc:Ignorable="d"
        Title="NexZeus - Gaming Intelligence Platform" Height="850" Width="800">
    <Grid Background="Black" Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Navigation -->
        <Button Grid.Row="0" Content="⚙ Settings" Width="100" Height="30" FontSize="12" 
                HorizontalAlignment="Right" VerticalAlignment="Top" Click="OpenSettings_Click"/>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="StatusText" Text="Welcome to NexZeus" 
                       FontSize="28" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <Button Content="Start Diagnostics" Width="180" Height="40" 
                    FontSize="14" Click="StartButton_Click"/>

            <!-- Real-Time Metrics -->
            <TextBlock x:Name="CpuText" Text="CPU: --%" 
                       FontSize="16" Foreground="LightGreen" 
                       Margin="0,20,0,5" HorizontalAlignment="Center"/>
            <TextBlock x:Name="RamText" Text="App RAM: -- GB" 
                       FontSize="16" Foreground="LightBlue" 
                       Margin="0,5,0,0" HorizontalAlignment="Center"/>
            <TextBlock x:Name="SysRamText" Text="System RAM: --" 
                       FontSize="16" Foreground="Orange" 
                       Margin="0,5,0,0" HorizontalAlignment="Center"/>
            <TextBlock x:Name="GpuText" Text="GPU: --" 
                       FontSize="14" Foreground="Violet" 
                       Margin="0,5,0,0" HorizontalAlignment="Center"/>

            <!-- Network Monitoring -->
            <TextBlock x:Name="PingText" Text="Ping: --" 
                       FontSize="14" Foreground="Cyan" 
                       Margin="0,5,0,0" HorizontalAlignment="Center"/>
            <TextBlock x:Name="JitterText" Text="Jitter: --" 
                       FontSize="14" Foreground="Cyan" 
                       Margin="0,5,0,0" HorizontalAlignment="Center"/>
            <TextBlock x:Name="PacketLossText" Text="Packet Loss: --" 
                       FontSize="14" Foreground="Cyan" 
                       Margin="0,5,0,0" HorizontalAlignment="Center"/>

            <!-- Roblox Process Monitor -->
            <TextBlock x:Name="RobloxStatusText" Text="Roblox: Not Running" 
                       FontSize="16" FontWeight="Bold" Foreground="Gray" 
                       Margin="0,15,0,0" HorizontalAlignment="Center"/>

            <!-- Session Recording Control -->
            <Button Content="Stop &amp; Save Report" Width="180" Height="35" 
                    FontSize="13" Margin="0,15,0,0" Click="StopSession_Click"/>

            <!-- Session History Button -->
            <Button Content="View Past Sessions" Width="180" Height="35" 
                    FontSize="13" Margin="0,10,0,0" Click="ViewHistory_Click"/>

            <!-- Bottleneck Diagnostics & Recommendations Report -->
            <TextBlock x:Name="ReportText" Text="" FontSize="12" Foreground="Yellow" 
                       Margin="0,10,0,0" HorizontalAlignment="Center" 
                       TextWrapping="Wrap" Width="380" TextAlignment="Center"/>

            <!-- Windows Optimization Check -->
            <Button Content="Check Windows Optimization" Width="200" Height="35" 
                    FontSize="13" Margin="0,10,0,0" Click="CheckOptimization_Click"/>
            <TextBlock x:Name="OptimizationText" Text="" FontSize="12" Foreground="LightYellow" 
                       Margin="0,10,0,0" HorizontalAlignment="Center" 
                       TextWrapping="Wrap" Width="380" TextAlignment="Center"/>

            <!-- Apply Fixes Button -->
            <Button Content="Apply Recommended Fixes" Width="200" Height="35" 
                    FontSize="13" Margin="0,10,0,0" Click="ApplyFixes_Click"/>

            <!-- Stutter Events Display -->
            <TextBlock x:Name="StutterText" Text="Stutter Events: 0" 
                       FontSize="14" Foreground="OrangeRed" 
                       Margin="0,15,0,0" HorizontalAlignment="Center"/>

            <!-- Real-Time Threshold Warning Display -->
            <TextBlock x:Name="WarningText" Text="" FontSize="14" FontWeight="Bold" 
                       Foreground="Red" Margin="0,15,0,0" HorizontalAlignment="Center" 
                       TextWrapping="Wrap" Width="320" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
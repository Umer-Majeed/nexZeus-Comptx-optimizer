<Window x:Class="NexZeus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NexZeus"
        mc:Ignorable="d"
        Title="NexZeus - Gaming Intelligence Platform" Height="450" Width="800">
    <Grid Background="Black">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="StatusText" Text="Welcome to NexZeus" 
                       FontSize="28" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <Button Content="Start Diagnostics" Width="180" Height="40" 
                    FontSize="14" Click="StartButton_Click"/>

            <!-- System Stats Section -->
            <TextBlock x:Name="CpuText" Text="CPU: --%" 
                       FontSize="16" Foreground="LightGreen" 
                       Margin="0,20,0,5" HorizontalAlignment="Center"/>
            <TextBlock x:Name="RamText" Text="RAM: --%" 
                       FontSize="16" Foreground="LightBlue" 
                       Margin="0,0,0,0" HorizontalAlignment="Center"/>

            <!-- New System RAM and GPU Section -->
            <TextBlock x:Name="SysRamText" Text="System RAM: --" 
                       FontSize="16" Foreground="Orange" 
                       Margin="0,5,0,0" HorizontalAlignment="Center"/>
            <TextBlock x:Name="GpuText" Text="GPU: --" 
                       FontSize="14" Foreground="Violet" 
                       Margin="0,5,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>